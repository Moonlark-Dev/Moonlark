# Tip:
# 请将此文件复制到 `.env` 后根据实际情况更改

# 以下内容不建议更改
HOST="0.0.0.0"
ALCONNA_USE_COMMAND_START=True
DRIVER=~fastapi+~httpx+~websockets
ALEMBIC_VERSION_LOCATIONS=migrations/versions
ALEMBIC_SCRIPT_LOCATION=migrations
BILICHAT_CACHE_SERVICE=json
HTMLRENDER_BROWSER="firefox"
PS_REPLY_TARGET=False
MCSTAT_REPLY_TARGET=False
BILICHAT_COMMAND_TO_ME=False

# 以下内容请自行填写
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///database.db
WOLFRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_DEFAULT_MODEL=moonshotai/kimi-k2:free
MODEL_OVERRIDE='{"Image Describe": "google/gemini-2.5-flash", "Message Summary (Broadcast)": "google/gemini-2.5-pro", "Message Summary (Daily)": "google/gemini-2.5-pro", "Chat": "deepseek/deepseek-v3.2-exp"}'
# Gemini API 配置（/chat model gemini 时 Chat 的主模型走这套 SDK；模型用 /gem-model 管理）
# 使用 AxonHub 等网关时把 GEMINI_BASE_URL 填成网关的 Gemini 接口地址，留空则使用官方地址
GEMINI_API_KEY=
GEMINI_BASE_URL=
# 网关只提供 v1beta 接口时填写 v1beta，留空由 SDK 决定
GEMINI_API_VERSION=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# OpenRouter Decisions API 配置（https://openrouter.ai/docs/guides/features/decisions），
# 用于 chat 的心情/好感度判定、滑动窗口相关性判断、触发概率预处理与笔记整理；
# 可选模型如 google/gemini-decision-1、~typesafe/jev-latest 等；不填写 Key 时相关调用会跳过
DECISION_API_KEY=
DECISION_BASE_URL=https://openrouter.ai/api/alpha
DECISION_MODEL=google/gemini-decision-1
SENTRY_DSN=
MOONLARK_API_BASE=
WAKATIME_APP_ID=
WAKATIME_APP_SECRET=
TRANSLATE_DEEPLX_URL=
METASO_API_KEY=
# markdown 消息图片（签到卡片、排行榜、题目卡片等）通过 QQ 官方机器人的「素材管理」
# 接口上传，再以 qqbot-media:// 引用内嵌，无需配置任何图床或对象存储
# 和风天气 API Key（https://dev.qweather.com），用于获取实时天气与每日天气
QWEATHER_API_KEY=
# 和风天气 API Host（标准订阅为账号专属域名，如 https://xxxx.re.qweatherapi.com）；不填写则使用公共地址
QWEATHER_API_HOST=
# 和风天气 GeoAPI Host（城市搜索，一般无需填写）；专属 Host 不提供城市搜索时可另行指定
QWEATHER_GEO_API_HOST=
# Moonlark 所在地区的经纬度，用于获取所在地每日天气；不填写则天气相关功能不启用
MOONLARK_LATITUDE=
MOONLARK_LONGITUDE=
# 用户主动私聊后的静默时长（小时）：期间不向该用户发起主动私聊；0 或负数表示关闭该限制
PROACTIVE_CHAT_USER_ACTIVE_COOLDOWN_HOURS=12
# chat 插件：主人（XiaoDeng3386）的账号标识（QQ 号，也可以填其群昵称），
# 用于在群聊会话元数据中生成「主人是否在当前会话」指示（依据 Message Summary 记录判定，
# 判定结果保存在 chatgroup 表中且只增不减）；不填写则不生成该指示，私聊始终不生成
CHAT_MASTER_USER_ID=
# bots 插件配置
# bot 代码名到 QQ 号的映射，用于 API 查询
BOTS_LIST='{"main": "123456789", "secondary": "987654321"}'
# QQ 官方 bot 的 app_id 到 QQ 号的映射，用于识别自收自发消息
# 格式: {"app_id": "qq_number"}
BOTS_APPID_MAP='{"102xxxxxx": "3889000000"}'
# 群绑定验证码过期时间（秒）
BOTS_BIND_GROUP_TIMEOUT=300
# qq_group 插件：QQ 官方 Bot 群聊信息 / 群成员列表缓存
# 是否启用群信息与群成员列表的周期性同步
QQ_GROUP_SYNC_ENABLED=true
# 周期性同步任务的执行间隔（秒），默认 30 分钟
QQ_GROUP_SYNC_INTERVAL=1800
# 群成员列表缓存有效期（秒），超过后由周期任务重新拉取，默认 1 小时
QQ_GROUP_MEMBER_CACHE_TTL=3600
# 群基本信息缓存有效期（秒），默认 6 小时
QQ_GROUP_INFO_CACHE_TTL=21600
# 单个群一次同步最多缓存的成员数，防止游标异常时无限翻页
QQ_GROUP_MEMBER_MAX_COUNT=3000
# menupanel 插件：QQ 自定义菜单「在线帮助」link 项跳转的前端帮助页地址
# 超管使用 NoneBot 标准 SUPERUSERS 配置，无需单独设置
MENUPANEL_FRONTEND_HELP_URL="https://moonlark.itcdt.top/#/help"
CORS_ALLOW_ORIGINS='["*"]'
# ── Passkey (WebAuthn) 登录 ──
# 网页前端的完整 origin（协议 + 域名，不含路径），例如 https://moonlark.itcdt.top
# WebAuthn 以它校验浏览器回传的 origin；生产环境必须配置，否则只能回退到请求头（仅限本地开发）。
# PASSKEY_ORIGIN="https://moonlark.itcdt.top"
# Relying Party ID（默认为 PASSKEY_ORIGIN 的主机名；个别部署需要固定域名时再设置）
# PASSKEY_RP_ID="moonlark.itcdt.top"
# 注册 Passkey 时展示给用户的站点名称
# PASSKEY_RP_NAME="Moonlark"
