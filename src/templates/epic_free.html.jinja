{% extends base %}

{% block header %}
<script>
    function getCountDownString(dateStr) {
        const targetDate = new Date(dateStr);
        const now = new Date();
        const timeDiff = targetDate.getTime() - now.getTime();
        const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        return `${days}d${hours}h`;
    }
</script>
{% endblock header %}

{% block body %}
{% for game in games %}
<div class="row">
    <div class="col-2">
        {% if game.image %}
        <img src="{{ game.image }}" alt="{{ game.title }}" class="img-fluid">
        {% endif %}
    </div>
    <div class="col-10">
        <h2>{{ game.title }}</h2>
        {% if game.original_price %}
        <span class="badge bg-dark"><s>{{ game.original_price }}</s></span>
        {% endif %}
        {% if game.free_now %}
        <span class="badge bg-success">{{ free_now }}</span>
        {% else %}
        <span class="badge bg-warning">{{ coming_soon }}</span>
        {% endif %}
        {% if game.countdown_date %}
        {{ remaining }} <span id="countdown-{{ loop.index }}"></span>
        <script>
            document.getElementById("countdown-{{ loop.index }}").innerHTML =
                getCountDownString("{{ game.countdown_date }}");
        </script>
        {% endif %}
        <br>
        <small class="text-secondary">{{ game.description }}</small>
        {% if game.url %}
        <br>
        <small class="text-secondary">{{ store_link }}: {{ game.url }}</small>
        {% endif %}
    </div>
</div>
{% if not loop.last %}
<hr>
{% endif %}
{% endfor %}
{% endblock body %}
