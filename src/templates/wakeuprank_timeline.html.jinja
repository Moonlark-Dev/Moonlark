{% extends base %}

{% block header %}
<style>
    /* 时间轴：左边固定宽度的时间文本，右边是可伸缩的轨道，圆点与刻度线都按百分比定位。
       标签、竖线、圆点都用同一个 percent 换算结果，所以换 viewport 宽度也不会错位。

       注意：文字颜色靠 .text-dark 继承主题（default/wide 是深色字、redpacket 主题把
       .text-dark 覆盖成 #F9A633）。不能只依赖 body 的颜色——MDB 的 .card 会给后代设
       #4f4f4f，在 redpacket 的深红卡片上几乎看不见。次要信息用 opacity 压暗，
       行列分隔线用半透明灰，这样四个主题下都不会出现「深色字压深色卡片」。 */
    .wake-timeline {
        font-size: 14px;
    }
    .wake-timeline .tl-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 85%;
        opacity: 0.75;
    }
    .wake-timeline .tl-legend {
        display: flex;
        align-items: center;
    }
    .wake-timeline .tl-legend-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 5px;
        border-radius: 50%;
        background: #f5941f;
    }
    .wake-timeline .tl-axis {
        display: flex;
        align-items: flex-end;
    }
    .wake-timeline .tl-axis-spacer {
        flex: 0 0 68px;
    }
    /* 与 .tl-track 一样带左右 1px 边框，保证标签的百分比基准和轨道一致 */
    .wake-timeline .tl-axis-track {
        position: relative;
        flex: 1 1 auto;
        height: 16px;
        border-left: 1px solid transparent;
        border-right: 1px solid transparent;
    }
    .wake-timeline .tl-axis-label {
        position: absolute;
        bottom: 3px;
        font-size: 75%;
        opacity: 0.65;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }
    .wake-timeline .tl-axis-start {
        transform: translateX(0);
    }
    .wake-timeline .tl-axis-center {
        transform: translateX(-50%);
    }
    .wake-timeline .tl-axis-end {
        transform: translateX(-100%);
    }
    .wake-timeline .tl-rows {
        border-top: 1px solid rgba(128, 128, 128, 0.45);
    }
    .wake-timeline .tl-row {
        display: flex;
        align-items: center;
        height: 32px;
    }
    .wake-timeline .tl-row:nth-child(even) {
        background: rgba(128, 128, 128, 0.1);
    }
    .wake-timeline .tl-row.tl-row-me {
        background: rgba(245, 148, 31, 0.22);
        font-weight: 600;
    }
    .wake-timeline .tl-time {
        flex: 0 0 68px;
        font-size: 85%;
        opacity: 0.85;
        font-variant-numeric: tabular-nums;
    }
    .wake-timeline .tl-track {
        position: relative;
        flex: 1 1 auto;
        height: 100%;
        border-left: 1px solid rgba(128, 128, 128, 0.45);
        border-right: 1px solid rgba(128, 128, 128, 0.45);
    }
    .wake-timeline .tl-tick {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: rgba(128, 128, 128, 0.28);
    }
    .wake-timeline .tl-marker {
        position: absolute;
        top: 50%;
        width: 0;
        height: 0;
    }
    .wake-timeline .tl-dot {
        position: absolute;
        width: 9px;
        height: 9px;
        margin-top: -4.5px;
        margin-left: -4.5px;
        border-radius: 50%;
        background: #4a9eff;
        box-shadow: 0 0 0 2px rgba(74, 158, 255, 0.18);
    }
    .wake-timeline .tl-dot.tl-dot-me {
        background: #f5941f;
        box-shadow: 0 0 0 2px rgba(245, 148, 31, 0.2);
    }
    .wake-timeline .tl-name {
        position: absolute;
        top: 50%;
        max-width: 150px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        transform: translateY(-50%);
        font-size: 85%;
    }
    .wake-timeline .tl-name.tl-name-right {
        left: 11px;
    }
    .wake-timeline .tl-name.tl-name-left {
        right: 11px;
        text-align: right;
    }
</style>
{% endblock header %}

{% block body %}
<div class="wake-timeline text-dark">
    <div class="tl-summary">
        <span>{{ count_label }}</span>
        {% if has_me %}
        <span class="tl-legend"><span class="tl-legend-dot"></span>{{ me_label }}</span>
        {% endif %}
    </div>
    <div class="tl-axis">
        <span class="tl-axis-spacer"></span>
        <span class="tl-axis-track">
            {% for tick in axis_ticks %}<span class="tl-axis-label tl-axis-{{ tick.align }}" style="left: {{ tick.percent }}%">{{ tick.text }}</span>{% endfor %}
        </span>
    </div>
    <div class="tl-rows">
        {% for point in points %}
        <div class="tl-row{% if point.is_me %} tl-row-me{% endif %}">
            <span class="tl-time">{{ point.time }}</span>
            <span class="tl-track">
                {% for tick in axis_ticks if 0 < tick.percent < 100 %}<span class="tl-tick" style="left: {{ tick.percent }}%"></span>{% endfor %}
                <span class="tl-marker" style="left: clamp(5px, {{ point.percent }}%, calc(100% - 5px))">
                    <span class="tl-dot{% if point.is_me %} tl-dot-me{% endif %}"></span>
                    <span class="tl-name{% if point.percent > 55 %} tl-name-left{% else %} tl-name-right{% endif %}">{{ point.nickname }}</span>
                </span>
            </span>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock body %}
